# Firebase Web SDK configuration for the content mirror.
#
# These are PUBLIC values: they identify the `oqthara` project to the browser SDK and are
# visible in every deployed bundle regardless. They are not administrative credentials and
# they are not secrets. The site ships the same values as built-in defaults, so leaving this
# file unconfigured still works.
#
# Override a value only when pointing a preview build at a different project. Setting
# VITE_FIREBASE_DISABLE_DEFAULTS=1 makes a missing required key a hard failure instead of
# silently falling back to production.

VITE_FIREBASE_API_KEY=AIzaSyA6GUE_5lbaadRxGZZi1_pvj7RMB8BFuDc
VITE_FIREBASE_AUTH_DOMAIN=oqthara.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=oqthara
VITE_FIREBASE_STORAGE_BUCKET=oqthara.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=788054550913
VITE_FIREBASE_APP_ID=1:788054550913:web:6b02c5a3889337e1c8e080
VITE_FIREBASE_MEASUREMENT_ID=G-KDW7QD0CMZ

# Set to 1 to disable the public defaults above.
VITE_FIREBASE_DISABLE_DEFAULTS=0

# --- Never put these in this file, and never prefix them with VITE_ ---
# GOOGLE_APPLICATION_CREDENTIALS and FIREBASE_SERVICE_ACCOUNT are Admin SDK credentials for
# scripts/sync-firestore.mjs and GitHub Actions. Vite would inline a VITE_-prefixed secret into
# the public bundle.
