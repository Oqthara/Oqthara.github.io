{
  "name": "oqthara-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Oqthara website: a React application prerendered to static HTML.",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:app",
    "build:app": "vite build && vite build --ssr src/prerender-entry.jsx --outDir .ssr && node prerender.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "verify": "node verify.mjs",
    "test:live": "OQ_LIVE_DOCS=1 node --test tests/live.test.js",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "github-slugger": "2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-react": "5.2.0",
    "vite": "8.3.5"
  }
}
